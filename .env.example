PORT=3000
ADMIN_PASS=change_this_admin_password
PUBLIC_BASE_URL=https://your-domain.example
COMMENT_BASE_URL=https://comment.yingyuzuowen.asia
ENGLISH_BASE_URL=https://notice.yingyuzuowen.asia
YEARLY_PLAN_PRICE=9.90
# Server-to-server secret shared with the teacher workbench only.
WORKBENCH_POINTS_SECRET=replace_with_a_random_service_secret
YUNGOU_MCH_ID=your_yungou_mch_id
YUNGOU_PAY_KEY=your_yungou_pay_key
YUNGOU_APP_ID=
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash

# Tencent Cloud standard TTS (premium voice package, default: 101001 智瑜)
TENCENT_TTS_SECRET_ID=your_tencent_secret_id
TENCENT_TTS_SECRET_KEY=your_tencent_secret_key
TENCENT_TTS_REGION=ap-guangzhou
TENCENT_TTS_VOICE_TYPE=101001

# Password reset email, QQ mail example
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_qq_email@qq.com
SMTP_PASS=your_smtp_authorization_code
MAIL_FROM=班级广播 <your_qq_email@qq.com>

# Optional runtime data paths
SQLITE_FILE=./broadcast.db
LEGACY_JSON_FILE=./data.json
BACKUP_DIR=./backups
